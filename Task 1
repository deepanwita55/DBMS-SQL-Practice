-- create
CREATE TABLE STUDENT (
  ID INTEGER PRIMARY KEY,
  name VARCHAR(50) NOT NULL,
  dept VARCHAR(20) NOT NULL,
  Age INT NOT NULL,
  Gender VARCHAR(10) NOT NULL,
  CGPA DECIMAL(3,2) NOT NULL,
  City VARCHAR(30) NOT NULL
);

